# Переменные для docker-compose.prod.yml (docker compose читает файл ".env" из
# той же папки, где лежит сам compose-файл — скопировать этот файл в ".env" и заполнить).
#
# ВАЖНО: POSTGRES_PASSWORD здесь должен СОВПАДАТЬ с паролем в DATABASE_URL
# внутри backend/.env — иначе backend не сможет подключиться к БД.

POSTGRES_PASSWORD=change_me_generate_a_strong_password
REDIS_PASSWORD=change_me_generate_a_strong_password

# Публичный домен фронтенда (встраивается в клиентский JS на этапе сборки).
NEXT_PUBLIC_API_BASE_URL=https://api.finance.example.ru
