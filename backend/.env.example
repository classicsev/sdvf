DATABASE_URL=postgresql+psycopg2://finance:finance_dev_password@db:5432/finance_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Ключ для шифрования персональных данных в БД (напр. банковские реквизиты
# сотрудников) — сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change_me_to_a_generated_fernet_key
# Продакшен-хост Т-Банк API; для тестов в песочнице переопределить на sandbox-хост
# (см. личный кабинет Т-Бизнеса → Интеграции → T-API) и токен TBankSandboxToken
TBANK_BASE_URL=https://business.tbank.ru/openapi
# Домен(ы) фронтенда через запятую, без пробелов. В проде — реальный HTTPS-домен,
# напр. CORS_ORIGINS=https://finance.example.ru
CORS_ORIGINS=http://localhost:3000
ENV=development

# Почта — self-hosted Postfix на проде (не сторонний сервис). В dev можно не
# настраивать — отправка молча не удастся, регистрация всё равно работает.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
MAIL_FROM=noreply@ваш-домен.ru
# Реальный HTTPS-домен фронтенда — для ссылки в письме подтверждения и адреса
# редиректа после успешного OAuth-входа
FRONTEND_BASE_URL=https://ваш-домен.ru
# Публичный HTTPS-домен бэкенда — сюда провайдеры (VK/Яндекс/Sber) редиректят
# после авторизации (redirect_uri), НЕ совпадает с FRONTEND_BASE_URL
BACKEND_BASE_URL=https://api.ваш-домен.ru

# OAuth — оставить пустым, если провайдер ещё не подключён (кнопка не покажется)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=

# Интеграция с СДВФ (sdvf.ru) — генерация Счёт/УПД из заказов Склада.
# Оставить пустым, если интеграция не подключена (кнопки не покажутся).
SDVF_BASE_URL=https://sdvf.ru
SDVF_API_KEY=

# Единый вход: Учёт как identity-провайдер для СДВФ (routers/identity_provider.py).
# redirect_uri — ровно тот URL колбэка на sdvf.ru, куда можно возвращать пользователя.
SDVF_SSO_REDIRECT_URI=https://sdvf.ru/auth/sso/callback
SDVF_SSO_CLIENT_SECRET=
